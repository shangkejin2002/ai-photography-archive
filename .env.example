# Backend database connection
DB_URL=jdbc:mysql://localhost:3306/user_center?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Tokyo
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_a_strong_password

# Runtime
SERVER_PORT=8080
COOKIE_SECURE=true

# Photography Archive storage
PHOTO_STORAGE_ROOT=/absolute/path/to/user-center-photo-storage
PHOTO_MAX_FILE_SIZE_BYTES=20971520
PHOTO_MAX_IMAGE_PIXELS=80000000

# DeepSeek Stage 5 visual analysis (create the key in the official console)
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
